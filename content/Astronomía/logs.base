filters:
  or:
    - file.folder == "Astronomía/Objetos"
    - file.folder == "content/Astronomía/Objetos"
    - file.folder == "Astronomía/Informes de observaciones/2026"
    - file.folder == "content/Astronomía/Informes de observaciones/2026"
views:
  - type: table
    name: Todos
    order:
      - file.name
      - object
      - object_type
      - constellation
      - place
      - seeing
      - telescope
      - eyepiece_name
      - eyepiece_mm
  - type: table
    name: Objetos
    filters:
      or:
        - file.folder == "Astronomía/Objetos"
        - file.folder == "content/Astronomía/Objetos"
    order:
      - file.name
      - object_type
      - constellation
  - type: table
    name: Informes
    filters:
      or:
        - file.folder == "Astronomía/Informes de observaciones/2026"
        - file.folder == "content/Astronomía/Informes de observaciones/2026"
    order:
      - file.name
      - object
      - place
      - seeing
      - telescope
      - eyepiece_name
      - eyepiece_mm
